{
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/*.pkl,data/master_train.csv}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/predict", "destination": "/api/index" },
    { "source": "/predict/timeline", "destination": "/api/index" },
    { "source": "/copilot", "destination": "/api/index" },
    { "source": "/copilot/remediation", "destination": "/api/index" }
  ]
}
